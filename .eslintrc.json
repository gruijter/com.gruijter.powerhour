{
    "ignorePatterns": [
        "build/",
        ".homeybuild/",
        "widgets/*/public/icons.js",
        "widgets/*/public/flow.js"
    ],
    "extends": "athom/homey-app",
    "overrides": [
        {
            "files": [
                "test/**/*.js"
            ],
            "rules": {
                "homey-app/global-timers": "off",
                "no-console": "off",
                "global-require": "off",
                "import/no-dynamic-require": "off",
                "no-process-exit": "off"
            }
        },
        {
            "files": [
                "tools/widget-shared/flow.js"
            ],
            "env": {
                "browser": true,
                "node": false
            },
            "parserOptions": {
                "sourceType": "script"
            }
        }
    ]
}
