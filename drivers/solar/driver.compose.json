    "button.retrain": {
      "maintenanceAction": true,
      "title": {
        "en": "Retrain solar forecast",
        "nl": "Hertrain zonne-voorspelling",
        "de": "Solarprognose neu trainieren",
        "fr": "Réentraîner les prévisions solaires",
        "it": "Riestrai previsione solare",
        "sv": "Träna om solprognos",
        "no": "Tren solprognose på nytt",
        "es": "Reentrenar pronóstico solar",
        "da": "Gentræn solprognose",
        "pl": "Przetrenuj prognozę solarną",
        "ru": "Переобучить солнечный прогноз",
        "ko": "태양광 예측 재학습",
        "ar": "إعادة تدريب التنبؤ الشمسي"
      },
      "desc": {
        "en": "Retrain the forecaster based on 14 days of history. WARNING: This will reset all long term learnings!",
        "nl": "Hertrain de voorspeller op basis van 14 dagen geschiedenis. WAARSCHUWING: dit reset alle langetermijn-leerresultaten!",
        "de": "Trainieren Sie den Prognostiker anhand von 14 Tagen Verlauf neu. WARNUNG: Dies setzt alle langfristigen Lernergebnisse zurück!",
        "fr": "Réentraînez le prévisionniste sur la base de 14 jours d'historique. ATTENTION : cela réinitialise tous les apprentissages à long terme !",
        "it": "Riaddestra il previsore in base a 14 giorni di cronologia. ATTENZIONE: questo azzererà tutti gli apprendimenti a lungo termine!",
        "sv": "Träna om prognosen baserat på 14 dagars historik. VARNING: Detta återställer all långsiktig inlärning!",
        "no": "Tren prognosen på nytt basert på 14 dagers historikk. ADVARSEL: Dette tilbakestiller all langsiktig læring!",
        "es": "Reentrene el pronosticador basándose en 14 días de historial. ADVERTENCIA: esto restablecerá todo el aprendizaje a largo plazo.",
        "da": "Gentræn prognosen baseret på 14 dages historik. ADVARSEL: Dette nulstiller al langsigtet læring!",
        "pl": "Przetrenuj prognozę na podstawie 14 dni historii. UWAGA: spowoduje to zresetowanie całej długoterminowej nauki!",
        "ru": "Переобучите прогноз на основе 14-дневной истории. ВНИМАНИЕ: это сбросит все долгосрочное обучение!",
        "ko": "14일간의 기록을 기반으로 예측 모델을 재학습합니다. 경고: 모든 장기 학습 내용이 초기화됩니다!",
        "ar": "أعد تدريب المتنبئ استنادًا إلى 14 يومًا من السجل. تحذير: سيؤدي هذا إلى إعادة تعيين جميع التعلمات طويلة المدى!"
      }
    },
